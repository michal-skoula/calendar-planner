.git
.github
node_modules
vendor
public/build
public/hot
# Drop cached artefacts but keep the directory skeleton: Laravel's .gitignore
# files are what make these directories exist in the image, and package:discover
# needs a writable cache path.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore

# Never ship the local package manifest: it was built with dev dependencies and
# names providers (Pail, Sail) that the production vendor tree does not have.
# The runtime stage regenerates it.
bootstrap/cache/*
!bootstrap/cache/.gitignore
database/database.sqlite
database/*.sqlite
.env
.env.*
!.env.example
tests
phpunit.xml
deploy
README.md
