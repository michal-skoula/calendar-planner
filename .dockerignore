.git
.github
.claude
.idea
**/node_modules
**/.DS_Store
deploy
README.md
**/README.md

apps/web/dist

apps/api/vendor
apps/api/tests
apps/api/phpunit.xml
apps/api/.phpunit.result.cache
apps/api/public/index.html
apps/api/public/assets

# Drop cached artefacts but keep the directory skeleton: Laravel's .gitignore
# files are what make these directories exist in the image, and package:discover
# needs a writable cache path.
apps/api/storage/logs/*
apps/api/storage/framework/cache/data/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
!apps/api/storage/logs/.gitignore
!apps/api/storage/framework/cache/data/.gitignore
!apps/api/storage/framework/sessions/.gitignore
!apps/api/storage/framework/views/.gitignore

# Never ship the local package manifest: it was built with dev dependencies and
# names providers (Pail, Sail) that the production vendor tree does not have.
# The runtime stage regenerates it.
apps/api/bootstrap/cache/*
!apps/api/bootstrap/cache/.gitignore
apps/api/database/*.sqlite
apps/api/.env
apps/api/.env.*
!apps/api/.env.example
