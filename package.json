{
    "name": "planner",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/web",
        "packages/*"
    ],
    "scripts": {
        "dev": "concurrently -k -n api,web -c gray,blue \"npm:dev:api\" \"npm:dev:web\"",
        "dev:api": "cd apps/api && php artisan serve --port=8100",
        "dev:web": "npm run dev -w @planner/web",
        "build": "npm run generate && npm run build -w @planner/web",
        "generate": "npm run generate -w @planner/api-client",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "cd apps/api && php artisan test"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
