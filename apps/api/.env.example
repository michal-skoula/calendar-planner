APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Planner ---------------------------------------------------------------
# The one account, created by `php artisan planner:user`. The same email and
# password sign in to the web UI and to CalDAV, and the email is also the DAV
# principal. The password is never in here — it lives hashed in the database.
PLANNER_USER_EMAIL=
PLANNER_TIMEZONE=Europe/Prague
PLANNER_DEFAULT_DURATION=30

# Named in the Basic auth challenge.
CALDAV_REALM=Tasks

# DAV request logging, to the container's stderr. `info` logs every request,
# which is what you want while a device refuses to sync; `warning` only failures.
DAV_LOG_LEVEL=warning

# Do not change the calendar URI once a device has added the account.
CALDAV_CALENDAR_URI=tasks
CALDAV_CALENDAR_NAME=Tasks
CALDAV_CALENDAR_COLOR='#0d6b68ff'

# iCalendar cannot mark a VEVENT done, so a finished task carries this prefix.
CALDAV_DONE_PREFIX='✅ '

# --- Subscribed calendars --------------------------------------------------
# Read-only iCal feeds, added at /calendars. The host's planner-feeds.timer
# fires every 15 minutes and refreshes whichever feeds are due by this.
PLANNER_FEED_REFRESH_MIN=60
PLANNER_FEED_TIMEOUT=10
PLANNER_FEED_MAX_BYTES=2097152

# Expansions are keyed on the payload hash, so this only stops the cache
# growing forever. A stale entry is unreachable rather than wrong.
PLANNER_FEED_CACHE_TTL=86400

# Local development only. With this on, http:// and private addresses are
# allowed, which on the box would let a pasted URL reach Caddy, n8n or anything
# else on the compose bridge. Leave it false in production.
PLANNER_FEED_ALLOW_PRIVATE=false

# --- Web app sign-in -------------------------------------------------------
# The web app signs in with a session cookie. APP_URL's host and the Vite dev
# server (localhost:5180) are always allowed to; list any other origin a browser
# will load the web app from here, comma separated. See config/sanctum.php.
# SANCTUM_STATEFUL_DOMAINS=
